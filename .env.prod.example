# Copy to ".env.prod" ON THE SERVER and fill in. Never commit .env.prod.
# Generate secrets with:  openssl rand -base64 48

# Your domain (the DNS A record must point to the VPS IP). No https://, no trailing slash.
DOMAIN=planner.example.com

# Database (only reachable inside the docker network)
PGDATABASE=sprintplanner
PGUSER=sprintplanner
PGPASSWORD=change-me-long-random

# JWT signing key: >= 32 chars, random. Changing it logs everybody out.
JWT_SECRET=change-me-openssl-rand-base64-48

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Trello "API key" (public identifier, baked into the frontend). Optional.
TRELLO_API_KEY=

# The single admin account (created on startup). Password: 12-72 chars.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars

# Set to false to close public signups (existing users can still log in)
REGISTRATION_ENABLED=true

# AI usage caps, in "units" (one full sprint plan = 4 units, guidance/retro = 1)
AI_PER_USER_HOURLY=16
AI_PER_USER_DAILY=40
AI_GLOBAL_DAILY=200
